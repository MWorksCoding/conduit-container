# Example env for docker-compose
# Backend
DJANGO_SECRET_KEY=unsafe-dev-secret
DJANGO_ALLOWED_HOSTS=0.0.0.0,127.0.0.1
DJANGO_DEBUG=TRUE

# Conduit specific
CONDUIT_DB_PATH=/app/data/db.sqlite3
CONDUIT_MEDIA_DIR=/app/media
CONDUIT_LOG_FILE=/var/log/conduit/app.log

# Frontend (if the app reads envs at runtime via some /config endpoint)
FRONTEND_API_URL=http://localhost:8000/api
